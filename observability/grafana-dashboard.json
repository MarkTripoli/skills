{
  "id": null,
  "uid": "archon-delivery",
  "title": "Archon Delivery",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "archon-prometheus", "value": "archon-prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (outcome) (rate(archon_runs_total[$__rate_interval]))", "legendFormat": "{{outcome}}" }]
    },
    {
      "id": 2,
      "title": "Runs per pack",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum by (workflow) (archon_runs_total)", "format": "table", "instant": true }]
    },
    {
      "id": 3,
      "title": "Run duration p50 and p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, workflow) (rate(archon_run_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{workflow}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, workflow) (rate(archon_run_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{workflow}}" }
      ]
    },
    {
      "id": 4,
      "title": "Node duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "topk(15, histogram_quantile(0.95, sum by (le, workflow, node, type) (rate(archon_node_duration_seconds_bucket[$__rate_interval]))))", "legendFormat": "{{workflow}} {{node}}" }]
    },
    {
      "id": 5,
      "title": "Gate wait p50 and p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, workflow, node) (rate(archon_gate_wait_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{workflow}} {{node}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, workflow, node) (rate(archon_gate_wait_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{workflow}} {{node}}" }
      ]
    },
    {
      "id": 6,
      "title": "Rejected gate rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum by (workflow, node) (rate(archon_gate_decisions_total{decision=\"rejected\"}[$__rate_interval])) / sum by (workflow, node) (rate(archon_gate_decisions_total[$__rate_interval]))", "legendFormat": "{{workflow}} {{node}}" }]
    },
    {
      "id": 7,
      "title": "Loop iterations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, workflow, node) (rate(archon_loop_iterations_bucket[$__rate_interval])))", "legendFormat": "{{workflow}} {{node}}" }]
    },
    {
      "id": 8,
      "title": "Tokens per pack",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum by (workflow, kind) (rate(archon_tokens_total[$__rate_interval]))", "legendFormat": "{{workflow}} {{kind}}" }]
    },
    {
      "id": 9,
      "title": "Cost per pack",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum by (workflow) (rate(archon_cost_usd_total[$__rate_interval]))", "legendFormat": "{{workflow}}" }]
    },
    {
      "id": 10,
      "title": "Last scrape age",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "time() - archon_metrics_db_mtime_seconds", "legendFormat": "seconds" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
